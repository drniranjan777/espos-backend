# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Set when running behind a reverse proxy (nginx, load balancer) so client IPs are correct
TRUST_PROXY=false

# ---- Database ----
DB_HOST=localhost
DB_PORT=5433
DB_NAME=jcb_inventory
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
# Used only by the test suite (it is wiped on every run)
DB_NAME_TEST=jcb_inventory_test

# ---- Auth ----
# Use long random strings (min 32 chars), e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# ---- Misc ----
LOG_LEVEL=info
UPLOAD_DIR=uploads
# Password for the seeded admin user (development seed only)
SEED_ADMIN_PASSWORD=Admin@123

# Business timezone ("today" for dashboards, stock dates, invoices)
APP_TIMEZONE=Asia/Kolkata
